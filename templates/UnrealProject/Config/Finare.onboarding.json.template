{
  "schemaVersion": "unifiedscript.unreal-project-onboarding/v0.1",
  "editorTarget": "__EDITOR_TARGET__",
  "gameTarget": "__GAME_TARGET__",
  "platform": "Win64",
  "configuration": "Development",
  "pluginPath": "../Plugins/Finare",
  "reflection": {
    "modules": [
      "Engine",
      "FinareRuntime"
    ],
    "classes": [
      "/Script/Engine.Actor",
      "/Script/FinareRuntime.FinareActor",
      "/Script/FinareRuntime.FinareComponent"
    ],
    "blueprintAssets": [],
    "output": "../Generated/__PROJECT_NAME__.reflection.json"
  },
  "bindings": {
    "namespace": "__MANAGED_NAMESPACE__.Generated",
    "managedOutput": "../Managed/__ASSEMBLY_NAME__/Generated/Unreal.bindings.generated.cs",
    "nativeOutput": "../Plugins/Finare/Source/FinareRuntime/Private/Generated/FinareRuntime.native-thunks.generated.cpp",
    "nodeCatalogOutput": "../Generated/__PROJECT_NAME__.api-nodes.json",
    "browserOutput": "../Generated/__PROJECT_NAME__.api-browser.json",
    "coverageOutput": "../Generated/__PROJECT_NAME__.binding-coverage.json",
    "failOnRejected": true,
    "requireCompleteNativeCoverage": true
  },
  "deployment": {
    "manifest": "../Deployment/__PROJECT_NAME__.finare-deployment.json",
    "enabled": true
  },
  "managed": {
    "configuration": "Release",
    "stageDirectory": "../Plugins/Finare/Binaries/Managed",
    "projects": [
      "../Managed/__ASSEMBLY_NAME__/__ASSEMBLY_NAME__.csproj"
    ],
    "chunks": [
      {
        "project": "../Managed/__ASSEMBLY_NAME__/__ASSEMBLY_NAME__.csproj",
        "stagePath": "../Plugins/Finare/Binaries/Managed/Scripts/__ASSEMBLY_NAME__.uschunk"
      }
    ]
  },
  "validation": {
    "automationFilter": "Finare.Unreal.ProjectSetup",
    "minimumAutomationTests": 2
  }
}
