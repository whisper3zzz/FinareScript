<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>__ASSEMBLY_NAME__</AssemblyName>
    <RootNamespace>__MANAGED_NAMESPACE__</RootNamespace>
    <OutputPath>../../Plugins/UEUnifiedScript/Binaries/Managed/Scripts/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnifiedScript.Core">
      <HintPath>../../Plugins/UEUnifiedScript/Binaries/Managed/UnifiedScript.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnifiedScript.Unreal">
      <HintPath>../../Plugins/UEUnifiedScript/Binaries/Managed/UnifiedScript.Unreal.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
