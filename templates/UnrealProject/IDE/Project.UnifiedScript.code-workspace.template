{
  "folders": [
    {
      "name": "__PROJECT_NAME__",
      "path": "."
    },
    {
      "name": "UnifiedScript Documentation",
      "path": "Plugins/UEUnifiedScript/Tools/Documentation"
    }
  ],
  "settings": {
    "dotnet.defaultSolution": "Managed/__ASSEMBLY_NAME__/__ASSEMBLY_NAME__.slnx"
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "UnifiedScript: Build managed gameplay",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:__PROJECT_NAME__}/Managed/__ASSEMBLY_NAME__/__ASSEMBLY_NAME__.slnx",
          "--configuration",
          "Release"
        ],
        "problemMatcher": "$msCompile",
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "UnifiedScript: Build and prepare Unreal",
        "type": "process",
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:__PROJECT_NAME__}/Plugins/UEUnifiedScript/Tools/setup-unreal-project.ps1",
          "-Project",
          "${workspaceFolder:__PROJECT_NAME__}/__PROJECT_NAME__.uproject"
        ],
        "problemMatcher": "$msCompile"
      },
      {
        "label": "UnifiedScript: Validate project",
        "type": "process",
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:__PROJECT_NAME__}/Plugins/UEUnifiedScript/Tools/setup-unreal-project.ps1",
          "-Project",
          "${workspaceFolder:__PROJECT_NAME__}/__PROJECT_NAME__.uproject",
          "-ValidateOnly"
        ],
        "problemMatcher": "$msCompile"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "UnifiedScript: Attach managed gameplay",
        "type": "coreclr",
        "request": "attach",
        "processId": "${command:pickProcess}",
        "justMyCode": true,
        "requireExactSource": true
      }
    ]
  }
}
