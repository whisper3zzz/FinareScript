<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>UnifiedScript.Unreal.Demo</AssemblyName>
    <Description>Minimal gameplay assembly loaded by the UE World demo host.</Description>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <UnifiedScriptDemoStageDir>$(MSBuildProjectDirectory)/../../../HostProject/Plugins/UEUnifiedScript/Binaries/Managed/Demo</UnifiedScriptDemoStageDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/UnifiedScript.Unreal/UnifiedScript.Unreal.csproj" />
    <Compile Include="../UEUnifiedScriptRuntime.bindings.cs"
             Link="Generated/UEUnifiedScriptRuntime.bindings.cs" />
  </ItemGroup>
  <Target Name="StageUnrealManagedDemo" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_UnifiedScriptDemoFile Include="$(TargetPath)" />
      <_UnifiedScriptDemoFile Include="$(TargetDir)UnifiedScript.Unreal.Demo.deps.json"
                              Condition="Exists('$(TargetDir)UnifiedScript.Unreal.Demo.deps.json')" />
      <_UnifiedScriptDemoFile Include="$(MSBuildProjectDirectory)/UnifiedScript.Unreal.Demo.asset.json" />
      <_UnifiedScriptDemoFile Include="$(MSBuildProjectDirectory)/UnifiedScript.Unreal.Demo.surface.json" />
      <_UnifiedScriptDemoFile Include="$(MSBuildProjectDirectory)/UnifiedScript.Unreal.Demo.usgraph" />
    </ItemGroup>
    <MakeDir Directories="$(UnifiedScriptDemoStageDir)" />
    <Copy SourceFiles="@(_UnifiedScriptDemoFile)"
          DestinationFolder="$(UnifiedScriptDemoStageDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
